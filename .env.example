# Copy to .env and set only the providers you intend to use. Never commit .env.

# SQLite (optional; defaults to storage/backlinks.db)
# DATABASE_URL=sqlite:///storage/backlinks.db

# Search provider credentials (select one with SEARCH_PROVIDER where applicable)
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
PERPLEXITY_API_KEY=
MOZ_API_TOKEN=

# AI provider credentials (select one with AI_PROVIDER where applicable)
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=

# Optional provider model and endpoint overrides
NVIDIA_MODEL=
NVIDIA_BASE_URL=

# Optional grounded generated-response provider: gemini or perplexity
# Grounded runs are manual and remain separate from ordinary AI_PROVIDER generation.
GROUNDED_AI_PROVIDER=
GROUNDED_AI_MODEL=

# Optional persisted Moz authority freshness window (default: 30)
MOZ_AUTHORITY_FRESHNESS_DAYS=30
MAX_EMAILS_PER_RUN=10
MAX_EMAILS_PER_DAY=50

# Google Search Console (read-only OAuth refresh-token integration)
# Enable the Search Console API in Google Cloud and authorize the property first.
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=

# Google Analytics 4 (reuse Google OAuth after requesting analytics.readonly)
GA4_PROPERTY_ID=
