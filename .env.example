# Copy to .env and set only the providers you intend to use. Never commit .env.

# SQLite (optional; defaults to storage/backlinks.db)
# DATABASE_URL=sqlite:///storage/backlinks.db

# Search provider credentials (select one with SEARCH_PROVIDER where applicable)
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
PERPLEXITY_API_KEY=

# AI provider credentials (select one with AI_PROVIDER where applicable)
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=

# Optional provider model and endpoint overrides
NVIDIA_MODEL=
NVIDIA_BASE_URL=
